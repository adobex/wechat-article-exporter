{
  "name": "wechat-article-exporter",
  "version": "2.3.21",
  "type": "module",
  "scripts": {
    "debug": "nuxt dev --inspect",
    "predev": "node scripts/clean-dev-cache.mjs",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare_module NITRO_KV_DRIVER=cloudflare-kv-binding nuxt build",
    "deploy": "yarn build:cf && npx wrangler deploy",
    "preview": "yarn build:cf && npx wrangler dev",
    "member:issue": "bash scripts/issue-member.sh issue",
    "member:revoke": "bash scripts/issue-member.sh revoke",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --diagnostic-level=error --max-diagnostics=none",
    "lint:report": "biome lint . --max-diagnostics=none",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:high": "node scripts/check-dependency-audit.mjs",
    "quality": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn audit:high",
    "postinstall": "nuxt prepare",
    "docker:build": "docker build --build-arg VERSION=$npm_package_version -t ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version .",
    "docker:publish": "docker push ghcr.io/wechat-article/wechat-article-exporter:$npm_package_version"
  },
